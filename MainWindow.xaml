<Window x:Class="ClaudeStatusMonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:ClaudeStatusMonitor.Converters"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Claude Status Monitor"
        Height="260" Width="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonDown="Window_MouseRightButtonDown">

    <Window.Resources>
        <converters:UtilizationToColorConverter x:Key="UtilizationToColorConverter"/>
    </Window.Resources>

    <Grid>
        <wv2:WebView2 x:Name="BackgroundWebView"
                      Width="1"
                      Height="1"
                      Visibility="Hidden"
                      IsHitTestVisible="False" />

        <Border Background="#E0000000" CornerRadius="10" Padding="15">
            <StackPanel>
            <!-- Header -->
            <TextBlock Text="Claude Status Monitor" 
                       FontSize="14" 
                       FontWeight="Bold" 
                       Foreground="White" 
                       Margin="0,0,0,10"/>

            <!-- Session Limit (5h) -->
            <StackPanel Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Current session" Foreground="White" FontSize="12"/>
                    <TextBlock Grid.Column="1" x:Name="SessionPercent" Text="0%" Foreground="White" FontSize="12" FontWeight="Bold"/>
                </Grid>
                <ProgressBar x:Name="SessionProgressBar" 
                             Height="18" 
                             Minimum="0" 
                             Maximum="100" 
                             Value="0"
                             Foreground="{Binding Value, ElementName=SessionProgressBar, Converter={StaticResource UtilizationToColorConverter}}"
                             Margin="0,3,0,0"/>
                <TextBlock x:Name="SessionResetTime" 
                           Text="Zurücksetzung in --:--" 
                           Foreground="#B0FFFFFF" 
                           FontSize="10" 
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Weekly Limit (7d) -->
            <StackPanel Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="All models" Foreground="White" FontSize="12"/>
                    <TextBlock Grid.Column="1" x:Name="WeeklyPercent" Text="0%" Foreground="White" FontSize="12" FontWeight="Bold"/>
                </Grid>
                <ProgressBar x:Name="WeeklyProgressBar" 
                             Height="18" 
                             Minimum="0" 
                             Maximum="100" 
                             Value="0"
                             Foreground="{Binding Value, ElementName=WeeklyProgressBar, Converter={StaticResource UtilizationToColorConverter}}"
                             Margin="0,3,0,0"/>
                <TextBlock x:Name="WeeklyResetTime" 
                           Text="Zurücksetzung --.--.----, --:--" 
                           Foreground="#B0FFFFFF" 
                           FontSize="10" 
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Sonnet Limit (7d) -->
            <StackPanel Margin="0,0,0,5">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Sonnet only" Foreground="White" FontSize="12"/>
                    <TextBlock Grid.Column="1" x:Name="SonnetPercent" Text="0%" Foreground="White" FontSize="12" FontWeight="Bold"/>
                </Grid>
                <ProgressBar x:Name="SonnetProgressBar" 
                             Height="18" 
                             Minimum="0" 
                             Maximum="100" 
                             Value="0"
                             Foreground="{Binding Value, ElementName=SonnetProgressBar, Converter={StaticResource UtilizationToColorConverter}}"
                             Margin="0,3,0,0"/>
                <TextBlock x:Name="SonnetResetTime" 
                           Text="Zurücksetzung --.--.----, --:--" 
                           Foreground="#B0FFFFFF" 
                           FontSize="10" 
                           Margin="0,2,0,0"/>
            </StackPanel>

            <!-- Status Text -->
            <TextBlock x:Name="StatusText" 
                       Text="Last updated: loading..." 
                       Foreground="#80FFFFFF" 
                       FontSize="10" 
                       HorizontalAlignment="Center"
                       Margin="0,8,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
